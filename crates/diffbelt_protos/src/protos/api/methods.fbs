include "common.fbs";
include "generation.fbs";
include "phantom.fbs";
include "put_many.fbs";
include "query.fbs";
include "get_keys_around.fbs";
include "collection.fbs";

union RequestBody {
    Error: ErrorResponse,
    GetCollection: GetCollectionRequest,
    StartGeneration: StartGenerationRequest,
    CommitGeneration: CommitGenerationRequest,
    StartPhantom: StartPhantomRequest,
    PutMany: PutManyRequest,
    StartQuery: StartQueryRequest,
    NextQuery: NextQueryRequest,
    GetKeysAround: GetKeysAroundRequest,
    CreateCollection: CreateCollectionRequest,
}

union ResponseBody {
    Error: ErrorResponse,
    GetCollection: GetCollectionResponse,
    StartGeneration: StartGenerationResponse,
    CommitGeneration: CommitGenerationResponse,
    StartPhantom: StartPhantomResponse,
    PutMany: PutManyResponse,
    StartQuery: QueryResponse,
    NextQuery: QueryResponse,
    GetKeysAround: GetKeysAroundResponse,
    CreateCollection: CreateCollectionResponse,
}

table Request {
    body: RequestBody;
}

/// One of fields is required
table Response {
    body: ResponseBody;
}
