table Prop {
    key: string;
    value: string;
}

table ParsedLogLine {
    log_level: ubyte;
    timestamp_string: string;
    timestamp_milliseconds: uint64;
    timestamp_microseconds: uint16;
    logger_key: string;
    log_key: string;
    props: [Prop];
    extra: [string];
}

table LogTypeWithCount {
    name: string;
    count: uint64;
}

table ParsedLogLine1d {
    count: uint64;
    log_types: [LogTypeWithCount];
}
